          "css": "*{box-sizing:border-box}body{margin:0;padding:32px 34px;font:25px Arial,sans-serif;background:transparent;color:#202020}form{display:flex;height:68px;border:1.5px solid #ddd;border-radius:36px;align-items:center;padding:10px 14px 10px 22px;box-shadow:0 12px 35px #0000000d;background:#fcfcfc}input{font:inherit;flex:1;min-width:0;outline:none;border:0;background:none;color:#202020}button{font:inherit;flex:none;border:0;border-radius:50%;width:44px;height:44px;background:#202020;color:white;cursor:pointer}output{display:block;text-align:center;font-size:17px;padding-top:10px}",
