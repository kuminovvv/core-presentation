{
  "name": "core-presentation",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node scripts/run-studio.mjs",
    "test:built": "node --import tsx scripts/smoke-built.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "node scripts/smoke-editor.mjs",
    "typecheck": "tsc --noEmit",
    "export:html": "node scripts/export-html.mjs",
    "mcp": "node scripts/launch-mcp.mjs",
    "test:mcp": "node scripts/smoke-mcp.mjs",
    "test:live": "node scripts/smoke-live.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.5",
    "playwright-core": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  }
}
